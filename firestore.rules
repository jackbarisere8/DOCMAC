rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function relay(relayId) {
      return get(/databases/$(database)/documents/relays/$(relayId));
    }

    function isRelayOperator(relayId) {
      return signedIn()
          && request.auth.uid in relay(relayId).data.operatorIds;
    }

    function canReadRelay(relayId) {
      return signedIn()
          && (relay(relayId).data.visibility in ['public', 'unlisted']
              || isRelayOperator(relayId));
    }

    // Usernames are read one document at a time while onboarding. A username
    // can be created only by the account it belongs to and can never be moved
    // to a different account.
    match /usernames/{username} {
      allow get: if signedIn();
      allow list, delete: if false;

      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid;

      // The app writes the same username document again when a user resumes
      // onboarding. Permit that idempotent write, but never a UID change.
      allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == resource.data.uid;
    }

    // A handle names exactly one public identity. User and Relay handle
    // documents are created atomically with their owning record.
    match /handles/{handle} {
      allow get: if signedIn();
      allow list, delete: if false;

      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['kind', 'ownerId', 'relayId'])
          && request.resource.data.ownerId == request.auth.uid
          && (
            (request.resource.data.kind == 'user'
              && !('relayId' in request.resource.data))
            ||
            (request.resource.data.kind == 'relay'
              && request.resource.data.relayId is string
              && getAfter(/databases/$(database)/documents/relays/$(request.resource.data.relayId)).data.ownerId == request.auth.uid)
          );

      // A resumed onboarding flow may write the same user identity again,
      // but a handle can never be transferred or retyped.
      allow update: if signedIn()
          && resource.data.kind == 'user'
          && resource.data.ownerId == request.auth.uid
          && request.resource.data == resource.data;
    }

    // This document contains private contact information, so it belongs only
    // to its authenticated owner.
    match /users/{userId} {
      allow get, create, update: if signedIn()
          && request.auth.uid == userId;
      allow list, delete: if false;
    }

    // Scheduled signals are private to their organizer until a trusted server
    // process resolves invitee names into recipient accounts and delivers the
    // invitations. Clients may never create a schedule for someone else.
    match /callSchedules/{scheduleId} {
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'organizerId', 'title', 'note', 'startsAt', 'endsAt', 'callType',
            'inviteeNames', 'reminderEnabled', 'reminderAt', 'status', 'createdAt'
          ])
          && request.resource.data.organizerId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.note is string
          && request.resource.data.startsAt is timestamp
          && request.resource.data.endsAt is timestamp
          && request.resource.data.endsAt > request.resource.data.startsAt
          && request.resource.data.callType in ['video', 'voice']
          && request.resource.data.inviteeNames is list
          && request.resource.data.reminderEnabled is bool
          && request.resource.data.reminderAt is timestamp
          && request.resource.data.status == 'scheduled';
      allow get, list, update, delete: if signedIn()
          && resource.data.organizerId == request.auth.uid;
    }

    // Relays are publishing identities. They have followers, not members;
    // only their owner/operators may publish or moderate.
    match /relays/{relayId} {
      allow get: if canReadRelay(relayId);
      allow list: if signedIn() && resource.data.visibility == 'public';
      allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.auth.uid in request.resource.data.operatorIds
          && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.ownerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.kind == 'relay';
      allow update, delete: if isRelayOperator(relayId);

      match /followers/{userId} {
        allow get, list: if canReadRelay(relayId);
        allow create, update, delete: if signedIn() && request.auth.uid == userId;
      }

      match /drops/{dropId} {
        allow get, list: if canReadRelay(relayId);
        allow create, update, delete: if isRelayOperator(relayId);

        match /replies/{replyId} {
          allow get, list: if canReadRelay(relayId);
          allow create: if signedIn()
              && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if signedIn()
              && (resource.data.authorId == request.auth.uid
                  || isRelayOperator(relayId));
        }
      }
    }
  }
}
