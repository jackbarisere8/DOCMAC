rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function relay(relayId) {
      return get(/databases/$(database)/documents/relays/$(relayId));
    }

    function isRelayOperator(relayId) {
      return signedIn()
          && request.auth.uid in relay(relayId).data.operatorIds;
    }

    function canReadRelay(relayId) {
      return signedIn()
          && (relay(relayId).data.visibility in ['public', 'unlisted']
              || isRelayOperator(relayId));
    }

    // Chats are created by the `ensureDirectChat` Cloud Function using the
    // Admin SDK, which bypasses these rules. Clients may read a chat only when
    // they are listed as a participant (legacy chats) or have a membership
    // document (new chats). They can never rewrite membership.
    function isChatMember(chatId) {
      return signedIn()
          && (
            exists(/databases/$(database)/documents/chats/$(chatId)/members/$(request.auth.uid))
            || (
              exists(/databases/$(database)/documents/chats/$(chatId))
              && request.auth.uid in get(
                /databases/$(database)/documents/chats/$(chatId)
              ).data.participantIds
            )
          );
    }

    match /chats/{chatId} {
      allow get: if isChatMember(chatId);
      // Inbox queries are filtered by participantIds, so `resource` already
      // proves membership per document without extra get/exists lookups.
      allow list: if signedIn()
          && request.auth.uid in resource.data.participantIds;
      // Only the Cloud Function may create chats or change membership.
      allow create, delete: if false;

      // A member may refresh the conversation preview after sending a message.
      allow update: if isChatMember(chatId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderId', 'updatedAt'])
          && request.resource.data.lastMessage is string
          && request.resource.data.lastMessage.size() <= 280
          && request.resource.data.lastSenderId == request.auth.uid
          && request.resource.data.lastMessageAt is timestamp
          && request.resource.data.updatedAt is timestamp;

      // A member may clear their unread badge.
      allow update: if isChatMember(chatId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unreadCount', 'updatedAt'])
          && request.resource.data.unreadCount is int
          && request.resource.data.unreadCount >= 0
          && request.resource.data.updatedAt is timestamp;

      match /members/{memberId} {
        allow get, list: if isChatMember(chatId);
        // Membership is written by the Cloud Function only.
        allow write: if false;
      }

      match /messages/{messageId} {
        allow get, list: if isChatMember(chatId);

        // Match ChatMessage.toMap(): a member may create only their own text
        // message in its parent chat. The stored chatId must match the path.
        allow create: if isChatMember(chatId)
            && request.resource.data.keys().hasOnly([
              'id', 'chatId', 'senderId', 'text', 'createdAt', 'isRead'
            ])
            && request.resource.data.id == messageId
            && request.resource.data.chatId == chatId
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000
            && request.resource.data.createdAt is timestamp
            && request.resource.data.isRead is bool;

        // Members may mark a message read, but cannot alter its sender, body,
        // timestamp, or chat identity. Messages cannot be deleted by clients.
        allow update: if isChatMember(chatId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isRead'])
            && request.resource.data.isRead is bool;
        allow delete: if false;
      }
    }

    // Public identity directory. Private contact details stay in `users`;
    // this document only holds the name and handle other people may discover.
    match /publicProfiles/{userId} {
      allow get, list: if signedIn();
      allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'uid', 'username', 'displayName', 'photoUrl', 'updatedAt'
          ])
          && request.resource.data.uid == userId
          && request.resource.data.username is string
          && request.resource.data.username.matches('^[a-z0-9_]{3,20}$')
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && (!('photoUrl' in request.resource.data)
            || request.resource.data.photoUrl is string)
          && request.resource.data.updatedAt is timestamp;
      allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'uid', 'username', 'displayName', 'photoUrl', 'updatedAt'
          ])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.username == resource.data.username
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() > 0
          && request.resource.data.displayName.size() <= 80
          && (!('photoUrl' in request.resource.data)
            || request.resource.data.photoUrl is string)
          && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // Usernames are read one document at a time while onboarding. Public read
    // allows prospective members to check availability before signing in. A
    // username can be created only by the authenticated account it belongs to
    // and can never be moved to a different account.
    match /usernames/{username} {
      allow get: if true;
      allow list, delete: if false;

      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == request.auth.uid;

      // The app writes the same username document again when a user resumes
      // onboarding. Permit that idempotent write, but never a UID change.
      allow update: if signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid'])
          && request.resource.data.uid == resource.data.uid;
    }

    // A handle names exactly one public identity. User and Relay handle
    // documents are created atomically with their owning record. Public read
    // allows availability checks during onboarding.
    match /handles/{handle} {
      allow get: if true;
      allow list, delete: if false;

      allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['kind', 'ownerId', 'relayId'])
          && request.resource.data.ownerId == request.auth.uid
          && (
            (request.resource.data.kind == 'user'
              && !('relayId' in request.resource.data))
            ||
            (request.resource.data.kind == 'relay'
              && request.resource.data.relayId is string
              && getAfter(/databases/$(database)/documents/relays/$(request.resource.data.relayId)).data.ownerId == request.auth.uid)
          );

      // A resumed onboarding flow may write the same user identity again,
      // but a handle can never be transferred or retyped.
      allow update: if signedIn()
          && resource.data.kind == 'user'
          && resource.data.ownerId == request.auth.uid
          && request.resource.data == resource.data;
    }

    // This document contains private contact information, so it belongs only
    // to its authenticated owner.
    match /users/{userId} {
      allow get, create, update: if signedIn()
          && request.auth.uid == userId;
      allow list, delete: if false;
    }

    // Scheduled signals are private to their organizer until a trusted server
    // process resolves invitee names into recipient accounts and delivers the
    // invitations. Clients may never create a schedule for someone else.
    match /callSchedules/{scheduleId} {
      allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'organizerId', 'title', 'note', 'startsAt', 'endsAt', 'callType',
            'inviteeNames', 'reminderEnabled', 'reminderAt', 'status', 'createdAt'
          ])
          && request.resource.data.organizerId == request.auth.uid
          && request.resource.data.title is string
          && request.resource.data.note is string
          && request.resource.data.startsAt is timestamp
          && request.resource.data.endsAt is timestamp
          && request.resource.data.endsAt > request.resource.data.startsAt
          && request.resource.data.callType in ['video', 'voice']
          && request.resource.data.inviteeNames is list
          && request.resource.data.reminderEnabled is bool
          && request.resource.data.reminderAt is timestamp
          && request.resource.data.status == 'scheduled';
      allow get, list, update, delete: if signedIn()
          && resource.data.organizerId == request.auth.uid;
    }

    // Relays are publishing identities. They have followers, not members;
    // only their owner/operators may publish or moderate.
    match /relays/{relayId} {
      allow get: if canReadRelay(relayId);
      allow list: if signedIn() && resource.data.visibility == 'public';
      allow create: if signedIn()
          && request.resource.data.ownerId == request.auth.uid
          && request.auth.uid in request.resource.data.operatorIds
          && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.ownerId == request.auth.uid
          && getAfter(/databases/$(database)/documents/handles/$(request.resource.data.handle)).data.kind == 'relay';
      allow update, delete: if isRelayOperator(relayId);

      match /followers/{userId} {
        allow get, list: if canReadRelay(relayId);
        allow create, update, delete: if signedIn() && request.auth.uid == userId;
      }

      match /drops/{dropId} {
        allow get, list: if canReadRelay(relayId);
        allow create, update, delete: if isRelayOperator(relayId);

        match /replies/{replyId} {
          allow get, list: if canReadRelay(relayId);
          allow create: if signedIn()
              && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if signedIn()
              && (resource.data.authorId == request.auth.uid
                  || isRelayOperator(relayId));
        }
      }
    }

    // Password-reset state belongs to Cloud Functions only. These documents
    // hold hashed codes, tokens and throttles, and the Admin SDK bypasses
    // rules, so no client (signed in or not) may touch them.
    match /passwordResetCodes/{docId} {
      allow read, write: if false;
    }

    match /passwordResetTokens/{docId} {
      allow read, write: if false;
    }

    match /passwordResetThrottle/{docId} {
      allow read, write: if false;
    }
  }
}
